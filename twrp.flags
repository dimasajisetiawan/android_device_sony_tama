# mount point    fstype    device            [device2]   fstype2
/boot            emmc      /dev/block/bootdevice/by-name/boot              flags=slotselect
/dtbo            emmc      /dev/block/bootdevice/by-name/dtbo              flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/bootdevice/by-name/vbmeta            flags=slotselect;display="VBMeta";backup=1;flashimg=1
/system_root     ext4      /dev/block/bootdevice/by-name/system            flags=slotselect;display="System";backup=1;wipeingui
/system_image    emmc      /dev/block/bootdevice/by-name/system            flags=slotselect
/vendor          ext4      /dev/block/bootdevice/by-name/vendor            flags=slotselect;display="Vendor";backup=1;wipeingui
/vendor_image    emmc      /dev/block/bootdevice/by-name/vendor            flags=slotselect
/oem             ext4      /dev/block/bootdevice/by-name/oem               flags=slotselect;display="OEM";backup=1
/data            ext4      /dev/block/bootdevice/by-name/userdata          flags=fileencryption=ice
/dsp             ext4      /dev/block/bootdevice/by-name/dsp               flags=slotselect;display="DSP"
/misc            emmc      /dev/block/bootdevice/by-name/misc
/firmware        vfat      /dev/block/bootdevice/by-name/modem             flags=slotselect;display="Firmware";fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/bt_firmware     vfat      /dev/block/bootdevice/by-name/bluetooth         flags=slotselect;display="BT Firmware";fsflags=ro,context=u:object_r:firmware_file:s0
/efs1            emmc      /dev/block/bootdevice/by-name/modemst1          flags=backup=1;display="EFS"
/efs2            emmc      /dev/block/bootdevice/by-name/modemst2          flags=backup=1;subpartitionof=/efs1
/persist         ext4      /dev/block/bootdevice/by-name/persist           flags=display="Persist";backup=1;fsflags="noatime,nosuid,nodev,barrier=1"
/persist_image   emmc      /dev/block/bootdevice/by-name/persist           flags=display="Persist Image";backup=1

/sdcard1         auto      /dev/block/mmcblk0p1                            flags=display="Micro SDcard";storage;wipeingui;removable
/usb-otg         auto      /dev/block/sdd1                                 flags=display="USB OTG";storage;wipeingui;removable
