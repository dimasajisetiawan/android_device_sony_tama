# mount point    fstype    device            [device2]   fstype2
/sd-ext          auto      /dev/block/mmcblk0p2                            flags=display="SD-ext";storage;wipeingui;removable;encryptable=userdata
/usbotg          auto      /dev/block/sdd1                                 flags=display="USB OTG";storage;wipeingui;removable
